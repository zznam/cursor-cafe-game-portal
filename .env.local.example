# Server-only configuration. Never use NEXT_PUBLIC_ for service credentials.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SESSION_SECRET=replace-with-at-least-32-random-characters
SITE_URL=http://localhost:3000
# Optional regional read replica or Supabase API load balancer (catalog reads only).
# SUPABASE_READ_URL=https://your-read-endpoint.supabase.co
# Optional image optimization allowlist, comma-separated exact hostnames.
# IMAGE_HOSTS=your-project.supabase.co
# Build-time only: CloudFront static asset URL; leave empty for local development.
# ASSET_PREFIX=https://your-distribution.cloudfront.net
