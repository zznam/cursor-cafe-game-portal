# Server-only PostgreSQL credentials. Use the pooled URL from Neon Connect.
DATABASE_URL=postgresql://user:password@your-project-pooler.region.aws.neon.tech/neondb?sslmode=require
# Optional direct URL for migrations. Defaults to DATABASE_URL.
# DATABASE_MIGRATION_URL=postgresql://user:password@your-project.region.aws.neon.tech/neondb?sslmode=require
# Optional catalog-only read connection. Social reads and all writes use primary.
# DATABASE_READ_URL=postgresql://user:password@your-read-endpoint/neondb?sslmode=require
SESSION_SECRET=replace-with-at-least-32-random-characters
SITE_URL=http://localhost:3000
# Optional image optimization allowlist, comma-separated exact hostnames.
# IMAGE_HOSTS=images.example.com
# Build-time only: CloudFront static asset URL; leave empty on Vercel.
# ASSET_PREFIX=https://your-distribution.cloudfront.net
